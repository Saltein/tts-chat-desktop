{
    "name": "tts-electron",
    "private": true,
    "version": "0.2.5",
    "type": "module",
    "main": "electron/main.js",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "electron": "electron .",
        "start": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron\"",
        "build:electron": "npm run build && electron-builder",
        "build:electron:win": "npm run build && electron-builder --win --publish never",
        "build:electron:mac": "npm run build && electron-builder --mac --publish never",
        "build:electron:linux": "npm run build && electron-builder --linux --publish never",
        "publish:win": "npm run build && electron-builder --win --publish always",
        "publish:mac": "npm run build && electron-builder --mac --publish always",
        "publish:linux": "npm run build && electron-builder --linux --publish always",
        "publish:all": "npm run build && electron-builder --win --mac --linux --publish always",
        "postinstall": "electron-builder install-app-deps && node patch-parser.js && patch-package"
    },
    "build": {
        "productName": "TTS-Chat-Desktop",
        "appId": "com.tts.electron",
        "directories": {
            "output": "release"
        },
        "extraMetadata": {
            "main": "electron/main.js"
        },
        "asar": true,
        "asarUnpack": [
            "electron/tts_server/**"
        ],
        "extraResources": [],
        "files": [
            "dist/**/*",
            "electron/**/*",
            "package.json"
        ],
        "win": {
            "target": "nsis",
            "icon": "public/icon.ico",
            "artifactName": "${productName}-Setup-${version}.${ext}"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": true,
            "allowToChangeInstallationDirectory": true,
            "include": "build/installer.nsh"
        },
        "publish": [
            {
                "provider": "github",
                "owner": "Saltein",
                "repo": "tts-electron-version",
                "releaseType": "release"
            }
        ]
    },
    "dependencies": {
        "@mkody/twitch-emoticons": "^2.9.7",
        "@react-oauth/google": "^0.12.2",
        "@reduxjs/toolkit": "^2.8.2",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@testing-library/user-event": "^13.2.1",
        "compose": "^0.1.2",
        "doker": "^0.0.8",
        "dompurify": "^3.4.2",
        "electron-updater": "^6.8.3",
        "express": "^5.2.1",
        "nginx": "^1.1.0",
        "patch-package": "^8.0.1",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-markdown": "^10.1.0",
        "react-qrcode-logo": "^4.0.0",
        "react-redux": "^9.2.0",
        "react-responsive": "^10.0.1",
        "react-router-dom": "^7.6.3",
        "react-scripts": "5.0.1",
        "redux": "^5.0.1",
        "remark-gfm": "^4.0.1",
        "reselect": "^5.1.1",
        "tmi.js": "^1.8.5",
        "to-words": "^5.5.0",
        "vite-plugin-svgr": "^5.2.0",
        "vklive-message-client": "^5.3.2",
        "web-vitals": "^2.1.0",
        "ws": "^8.20.0",
        "yarn": "^1.22.22",
        "youtubei.js": "^17.0.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "concurrently": "^9.2.1",
        "css-loader": "^7.1.2",
        "electron": "^41.2.2",
        "electron-builder": "^26.8.1",
        "eslint": "^9.39.4",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.5.0",
        "postcss-loader": "^8.1.1",
        "sass": "^1.89.2",
        "sass-loader": "^16.0.5",
        "vite": "^8.0.9",
        "wait-on": "^9.0.5"
    }
}
